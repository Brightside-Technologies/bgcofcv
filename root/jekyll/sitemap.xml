---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for collection in site.collections %}{% if collection.output %}
{% for doc in collection.docs %}{% unless doc.sitemap == false or doc.noindex %}
{% capture canonical_path %}{% include canonical-path.html url=doc.url %}{% endcapture %}
  <url><loc>{{ canonical_path | absolute_url | xml_escape }}</loc>{% if doc.last_modified_at %}<lastmod>{{ doc.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}</url>
{% endunless %}{% endfor %}{% endif %}{% endfor %}
{% for doc in site.html_pages %}{% unless doc.sitemap == false or doc.noindex or doc.url == '/404.html' %}
{% capture canonical_path %}{% include canonical-path.html url=doc.url %}{% endcapture %}
  <url><loc>{{ canonical_path | absolute_url | xml_escape }}</loc>{% if doc.last_modified_at %}<lastmod>{{ doc.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}</url>
{% endunless %}{% endfor %}
{% for file in site.static_files %}{% if file.extname == '.pdf' %}{% unless file.sitemap == false %}
  <url><loc>{{ file.path | absolute_url | xml_escape }}</loc></url>
{% endunless %}{% endif %}{% endfor %}
</urlset>
